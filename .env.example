# Copied to .env by scripts/start.ps1. Docker Compose reads .env for the ${...} values in
# docker-compose.yml; every value below is also the default when .env is missing.

# Local PostgreSQL in Docker (development credentials, not a secret)
POSTGRES_DB=seismic
POSTGRES_USER=seismic
POSTGRES_PASSWORD=seismic

KAFKA_TOPIC=seismic-events
SPARK_MASTER_URL=spark://spark-master:7077

# Live USGS producer: poll interval, and the feed loaded once at start-up (empty = no backfill)
POLL_SECONDS=60
USGS_BACKFILL_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_week.geojson

# Replay producer: shift the demo catalogue so that its last event happens now
REPLAY_REBASE_TO_NOW=true

# Analytics
Z_THRESHOLD=2.0
MIN_EVENTS_FOR_ANOMALY=3
BVALUE_MIN_EVENTS=20
MAX_KMEANS_CLUSTERS=5
ACTIVE_REGION_HOURS=24
REGION_RADIUS_KM=300

# Spark cores (the two workers offer 3 each): the streaming job holds at most STREAMING_MAX_CORES,
# the baselines batch job uses SPARK_BATCH_CORES beside it, so both can run at the same time.
STREAMING_MAX_CORES=4
SPARK_BATCH_CORES=2

# Historical baselines job (scripts/refresh_baselines.ps1): days of USGS history, end date (default today)
HISTORY_DAYS=90
HISTORY_END=
