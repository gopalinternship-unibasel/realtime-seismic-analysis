POSTGRES_DB=seismic
POSTGRES_USER=seismic
POSTGRES_PASSWORD=seismic
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SPARK_MASTER_URL=spark://spark-master:7077
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=seismic-events
KAFKA_STARTING_OFFSETS=earliest
CHECKPOINT_DIR=/opt/workspace/data/checkpoints/seismic_stream
BASELINE_CSV=/opt/workspace/data/baseline/cell_baselines.csv
HISTORICAL_CSV=/opt/workspace/data/historical/sample_historical_events.csv
POLL_SECONDS=60
Z_THRESHOLD=2.0
MIN_EVENTS_FOR_ANOMALY=3
