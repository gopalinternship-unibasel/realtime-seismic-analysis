FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless bash curl procps tini \
    && rm -rf /var/lib/apt/lists/*

# Debian names the JVM folder after the CPU (java-17-openjdk-amd64 or -arm64): one fixed path for both.
RUN ln -s "/usr/lib/jvm/java-17-openjdk-$(dpkg --print-architecture)" /usr/lib/jvm/java-17
ENV JAVA_HOME=/usr/lib/jvm/java-17
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/opt/workspace

WORKDIR /opt/workspace
COPY requirements-spark.txt /tmp/requirements-spark.txt
RUN pip install --no-cache-dir -r /tmp/requirements-spark.txt
# Test-only dependencies in their own layer so the large layer above stays cached.
COPY requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir -r /tmp/requirements-test.txt

ENV SPARK_HOME=/usr/local/lib/python3.11/site-packages/pyspark
ENV PATH="$SPARK_HOME/bin:$SPARK_HOME/sbin:$PATH"

COPY src /opt/workspace/src
COPY sql /opt/workspace/sql
COPY data /opt/workspace/data
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash"]
